# Netlify / Cloudflare Pages caching (Apache hosts use .htaccess; GitHub Pages reads neither).
# assets/ file names carry a version and content hash, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
